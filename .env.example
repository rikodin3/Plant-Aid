# =============================================================================
# Plant-Aid Environment Configuration Template
# Copy this file to .env in repository root for local Docker / native execution:
#   cp .env.example .env
# =============================================================================

# Application Settings
APP_NAME=Plant-Aid API
# DEBUG ONLY: When True, /auth/login returns generated OTP as otp_code_dev
APP_DEBUG=True

# Security & JWT Token Signing (Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
PLANT_AID_SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=5

# Port Mapping (for Docker Compose)
BACKEND_PORT=8000
FRONTEND_PORT=80

# Database Connection (Docker default uses container persistent volume at /app/data/plant_aid.db)
DATABASE_URL=sqlite:///./backend/plant_aid.db

# Storage / Upload Directory
UPLOAD_DIR=./backend/uploads

# 2FA OTP Provider (smtp | resend | console | twilio | sendgrid)
OTP_PROVIDER=smtp
OTP_ALLOW_CONSOLE_FALLBACK=True
MAX_OTP_RESENDS=3

# SMTP Relay Configuration (e.g., Gmail App Password, AWS SES, Mailgun, Brevo)
# For Gmail: 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_USE_STARTTLS=True
SMTP_FROM_EMAIL=your.email@gmail.com
SMTP_FROM_NAME=Plant-Aid Security
SMTP_TIMEOUT_SECONDS=10

# Resend API Configuration (optional, if OTP_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# AWS S3 Settings (optional cloud media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=plant-aid-media-bucket

# Rate Limiting
RATE_LIMIT_PASSWORD_RESET=5/minute
