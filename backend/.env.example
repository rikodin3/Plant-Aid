# Application Settings
APP_NAME=Plant-Aid API
# DEBUG ONLY. When true, /auth/login echoes the generated OTP as `otp_code_dev` so local and
# automated 2FA flows can complete without a real SMS/email provider. Always False in production.
APP_DEBUG=True

# Security & JWT (Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
PLANT_AID_SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=5

# Database (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./plant_aid.db

# Storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=plant-aid-media-bucket

# 2FA Notification Provider (smtp | resend | console | twilio | sendgrid)
OTP_PROVIDER=smtp
OTP_ALLOW_CONSOLE_FALLBACK=True
MAX_OTP_RESENDS=3

# SMTP Relay Configuration (e.g. Gmail App Password, AWS SES, custom relay)
# For Gmail: generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_USE_STARTTLS=True
SMTP_FROM_EMAIL=your.email@gmail.com
SMTP_FROM_NAME=Plant-Aid Security
SMTP_TIMEOUT_SECONDS=10

# Resend API Configuration (if OTP_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Twilio SMS (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid Email (if OTP_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
